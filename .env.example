# Copy this file to .env, then replace the placeholder values.
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=qantly_scout
POSTGRES_USER=qantly_scout
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=django-db

SUPPORT_EMAIL=
PRIVACY_EMAIL=
ACCOUNT_EMAIL_SUBJECT_PREFIX=[Qantly]
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=replace-with-private-email-password
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TIMEOUT=30

USE_SENDGRID=False
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_REPLY_TO=

OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: explicitly configured Greenhouse boards for development, testing,
# or monitoring known companies. General Scout discovery must not depend on this.
# Example: [{"company_name":"Example Research","board_token":"example-research","company_domain":"example.org"}]
GREENHOUSE_BOARDS_JSON=[]

# Public general-web jobs provider. The Muse works without an API key; a key can raise its rate limit.
SEARCH_PROVIDER=themuse
SEARCH_API_KEY=
SEARCH_MAX_PAGES=25
